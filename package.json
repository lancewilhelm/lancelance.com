{
  "name": "lancelance.com",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm check:content && pnpm images:check && vite build && vite build --ssr src/entry-server.ts --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "node scripts/serve-static.mjs",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check:content": "tsx scripts/check-content.ts",
    "images:generate": "node scripts/generate-images.mjs",
    "images:check": "node scripts/generate-images.mjs --check",
    "repos:refresh": "node scripts/fetch-github-repos.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@unhead/vue": "^2.1.14",
    "highlight.js": "^11.12.0",
    "katex": "^0.16.25",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.32",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.19.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.0",
    "vue-tsc": "^3.3.13"
  },
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22.22.3 <23"
  }
}
